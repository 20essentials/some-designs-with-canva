---
import { categories, projects } from '@/utils/taxonomy';
import { lengthOfProjects } from '@/utils/data';

const count = lengthOfProjects;
const first = projects[0].id;
const last = projects[projects.length - 1].id;
const kinds = categories.filter(({ id }) => id !== 'all');
---

<section class='hero' aria-labelledby='hero-title'>
  <p class='hero__rail' aria-hidden='true'>
    <span class='hero__rail-text'>Archive of experiments</span>
  </p>

  <div class='hero__frame'>
    <header class='hero__top'>
      <p class='hero__ident'>Archive</p>
      <p class='hero__range'>
        <span>Nos.</span>
        <span>{first}</span>
        <span aria-hidden='true'>&ndash;</span>
        <span>{last}</span>
      </p>
    </header>

    <div class='hero__body'>
      <h1 class='hero__title' id='hero-title'>
        <span class='hero__line'>
          <span class='hero__line-in'>{count} Designs</span>
        </span>
        <span class='hero__line hero__line--inset'>
          <span class='hero__line-in'>With <em class='hero__accent'>Canva</em></span>
        </span>
      </h1>

      <div class='hero__aside'>
        <p class='hero__lede'>
          A running archive of experiments made inside Canva. Every tile opens
          in the editor where it was built.
        </p>

        <a class='hero__cue' href='#archive'>
          <span>See the archive</span>
          <svg viewBox='0 0 12 8' aria-hidden='true' focusable='false'>
            <path
              d='M1 1.5 6 6.5l5-5'
              fill='none'
              stroke='currentColor'
              stroke-width='1.6'
            />
          </svg>
        </a>
      </div>
    </div>

    <footer class='hero__foot'>
      <ul class='hero__kinds'>
        {
          kinds.map(({ label, count: total }) => (
            <li class='hero__kind'>
              <span>{label}</span>
              <span class='hero__kind-count'>{total}</span>
            </li>
          ))
        }
      </ul>

      <p class='hero__note'>Filter by kind below</p>
    </footer>
  </div>
</section>

<style>
  /* The hero paints nothing of its own: the fixed WebGL field behind it
     is the background. Only a scrim, thin enough to stay transparent. */
  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    isolation: isolate;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(
        78% 60% at 6% 94%,
        color-mix(in oklab, var(--ink-deep) 74%, transparent) 0%,
        transparent 72%
      ),
      linear-gradient(
        to top,
        color-mix(in oklab, var(--ink-deep) 66%, transparent) 0%,
        transparent 42%
      );
  }

  /* Frame: meta rail on top, headline anchored to the lower half,
     category rail at the bottom. The 1fr row is what creates the
     asymmetry — the headline sits low, the breathing room sits above. */
  .hero__frame {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: clamp(var(--space-m), 4vh, var(--space-l));
    width: 100%;
    max-width: 96rem;
    min-height: 100svh;
    margin-inline: auto;
    padding:
      clamp(var(--space-l), 8vh, var(--space-xl)) var(--gutter)
      clamp(var(--space-m), 5vh, var(--space-l));
  }

  /* Rails ---------------------------------------------------------------- */

  .hero__top,
  .hero__foot {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--paper-dim);
  }

  .hero__top::after,
  .hero__foot::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    height: 1px;
    background: var(--edge-soft);
    transform-origin: 0 50%;
    animation: hero-rule 1000ms var(--ease-out) both;
  }

  .hero__top::after {
    bottom: 0;
  }

  .hero__foot::before {
    top: 0;
  }

  .hero__top {
    padding-bottom: var(--space-2xs);
    animation: hero-rise 620ms var(--ease-out) 60ms both;
  }

  .hero__foot {
    padding-top: var(--space-2xs);
    animation: hero-rise 620ms var(--ease-out) 460ms both;
  }

  .hero__ident {
    color: var(--paper);
    letter-spacing: 0.2em;
  }

  .hero__range {
    display: inline-flex;
    gap: 0.6em;
    font-variant-numeric: tabular-nums;
  }

  .hero__kinds {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-s);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero__kind {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45em;
    white-space: nowrap;
  }

  .hero__kind-count {
    font-variant-numeric: tabular-nums;
    color: color-mix(in oklab, var(--paper-dim) 55%, transparent);
  }

  .hero__note {
    color: color-mix(in oklab, var(--paper-dim) 55%, transparent);
    white-space: nowrap;
  }

  /* Body ----------------------------------------------------------------- */

  .hero__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(var(--space-m), 4vh, var(--space-xl));
    align-content: end;
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 400;
    line-height: 0.94;
    letter-spacing: -0.022em;
    color: var(--paper);
    text-wrap: balance;
  }

  /* Each line is its own mask so the headline reveals word by word. */
  .hero__line {
    display: block;
    overflow: hidden;
    padding-block: 0.06em;
    margin-block: -0.06em;
  }

  .hero__line-in {
    display: block;
    animation: hero-mask 950ms var(--ease-out) both;
  }

  .hero__line:nth-child(1) .hero__line-in {
    animation-delay: 140ms;
  }

  .hero__line:nth-child(2) .hero__line-in {
    animation-delay: 230ms;
  }

  /* The indent is the asymmetry: the second line hangs off the margin
     instead of stacking flush under the first. */
  .hero__line--inset .hero__line-in {
    margin-left: clamp(0rem, 7vw, 5.5rem);
  }

  .hero__accent {
    font-style: italic;
    color: var(--cyan);
    animation: hero-tint 800ms var(--ease-out) 700ms both;
  }

  .hero__aside {
    display: grid;
    justify-items: start;
    gap: var(--space-m);
    align-content: end;
    animation: hero-rise 640ms var(--ease-out) 480ms both;
  }

  .hero__lede {
    max-width: 38ch;
    font-size: var(--text-lede);
    line-height: 1.55;
    color: var(--paper-dim);
    text-wrap: pretty;
  }

  .hero__cue {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.7em 1.1em;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--ink);
    background: var(--paper);
    border-radius: 2px;
    transition:
      transform 180ms var(--ease-out),
      background-color 180ms var(--ease-out),
      box-shadow 180ms var(--ease-out);
  }

  .hero__cue svg {
    width: 0.7em;
    height: auto;
    transition: transform 180ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__cue:hover {
      background: #fff;
      transform: translate(-3px, -3px);
      /* Same hard-shadow language as the archive cards. */
      box-shadow: 5px 5px 0 var(--magenta);
    }

    .hero__cue:hover svg {
      transform: translateY(2px);
    }

    .hero__cue:active {
      transform: translate(0, 0);
      box-shadow: 1px 1px 0 var(--magenta);
    }
  }

  /* Margin rail ---------------------------------------------------------- */

  .hero__rail {
    position: absolute;
    top: 50%;
    left: calc(var(--gutter) * 0.26);
    translate: 0 -50%;
    pointer-events: none;
  }

  .hero__rail-text {
    display: block;
    writing-mode: vertical-rl;
    rotate: 180deg;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    white-space: nowrap;
    color: color-mix(in oklab, var(--paper-dim) 50%, transparent);
  }

  /* Wider viewports get the two-column editorial split: the headline
     takes the wide measure, the supporting column sits bottom-aligned
     against it. */
  @media (min-width: 56em) {
    .hero__body {
      grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr);
      align-items: end;
      column-gap: clamp(var(--space-l), 5vw, var(--space-xl));
    }

    .hero__rail {
      display: block;
    }
  }

  @media (max-width: 55.99em) {
    .hero__rail {
      display: none;
    }
  }

  @media (max-width: 40em) {
    .hero__note {
      display: none;
    }
  }

  /* Motion: one orchestrated entrance, ~1.4s, no loops. --------------- */

  @keyframes hero-rule {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes hero-mask {
    from {
      transform: translate3d(0, 108%, 0);
    }
    to {
      transform: none;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 12px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-tint {
    from {
      color: var(--paper);
    }
    to {
      color: var(--cyan);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__top,
    .hero__foot,
    .hero__top::after,
    .hero__foot::before,
    .hero__line-in,
    .hero__aside,
    .hero__accent {
      animation: hero-fade 240ms var(--ease-out) both;
    }

    .hero__cue {
      transition-duration: 1ms;
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>